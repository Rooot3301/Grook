# ─── Discord ──────────────────────────────────────────────────────────────────
# Token du bot Discord (obligatoire)
DISCORD_TOKEN=your_token_here

# Ton ID Discord — mention dans /botinfo + gate d'accès au dashboard (mono-user)
BOT_OWNER_ID=

# ID du serveur de développement pour un déploiement instantané des slash commands
# (laisser vide pour le déploiement global — peut prendre jusqu'à 1h)
DEV_GUILD_ID=

# ─── Features ─────────────────────────────────────────────────────────────────
# Clé API VirusTotal (optionnel — laisser vide pour désactiver le scanner de liens)
VIRUSTOTAL_API_KEY=

# Intervalle de rotation du rich presence en minutes (défaut : 5)
PRESENCE_INTERVAL_MIN=5

# ─── Dashboard web ────────────────────────────────────────────────────────────
# Active le dashboard d'administration (true/false, défaut : false)
DASHBOARD_ENABLED=false

# Port d'écoute du dashboard (défaut : 3000)
DASHBOARD_PORT=3000

# URL publique du dashboard (utilisée pour le callback OAuth2 Discord)
# Ex : https://grook.exemple.com — sans slash final. Défaut : http://localhost:${DASHBOARD_PORT}
DASHBOARD_PUBLIC_URL=

# OAuth2 Discord — créer une application sur https://discord.com/developers/applications
# puis ajouter le redirect URI : ${DASHBOARD_PUBLIC_URL}/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Secret utilisé pour signer les JWT de session (générer avec : openssl rand -hex 32)
DASHBOARD_JWT_SECRET=

# ─── Logging ──────────────────────────────────────────────────────────────────
# Niveau de log : debug | info | warn | error (défaut : info)
LOG_LEVEL=info
